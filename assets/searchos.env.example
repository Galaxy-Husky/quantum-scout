# Copy to /root/SearchOS/.env and replace placeholders locally.
# With searchos --setup, model cards/roles stay in web_settings.json.
DASHSCOPE_API_KEY=REPLACE_WITH_YOUR_KEY
# Environment-only alternative when no shared JSON config is used:
# SF_PROVIDER=dashscope
# SF_MODEL=REPLACE_WITH_YOUR_MODEL_ID
# SF_FAST_MODEL=REPLACE_WITH_YOUR_MODEL_ID
# Optional: select the API address appropriate for your account/region.
# SF_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen Coding Plan: use SF_PROVIDER=qwen-coding and its product-specific key.
# Discovery uses the shared SearchOS search provider and its own credentials.
# SERPER_API_KEY=REPLACE_WITH_YOUR_KEY
# TAVILY_API_KEY=REPLACE_WITH_YOUR_KEY
# Citation services are off by default; enable citation_identity in online JSON separately.
# Crossref and arXiv identity APIs do not require a key. S2 key is optional.
# OpenAlex requires OPENALEX_API_KEY in this adapter; S2 may remain disabled.
# S2_API_KEY=REPLACE_WITH_YOUR_KEY
# OPENALEX_API_KEY=REPLACE_WITH_YOUR_KEY
